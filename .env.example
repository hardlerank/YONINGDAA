# Documentation placeholder only. This static frontend has no build step and
# does not read .env files. Set the real public API origin in api-config.js before
# deployment, or inject window.YONINGDA_API_BASE_URL before api-config.js runs.
# Use a same-origin /api proxy only after its upstream backend is configured.
# This browser-visible value must be an origin only and must contain no secrets.
YONINGDA_API_BASE_URL=https://<YOUR_BACKEND_HOST>